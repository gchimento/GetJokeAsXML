<?xml version="1.0" encoding="UTF-8"?>

<Values version="2.0">
  <value name="svc_type">flow</value>
  <value name="svc_subtype">wmflow</value>
  <value name="svc_sigtype">unknown</value>
  <record name="svc_sig" javaclass="com.wm.util.Values">
    <record name="sig_in" javaclass="com.wm.util.Values">
      <value name="node_type">record</value>
      <value name="node_subtype">unknown</value>
      <value name="is_public">false</value>
      <value name="field_type">record</value>
      <value name="field_dim">0</value>
      <value name="nillable">true</value>
      <value name="form_qualified">false</value>
      <value name="is_global">false</value>
      <array name="rec_fields" type="record" depth="1">
        <record javaclass="com.wm.util.Values">
          <value name="node_type">record</value>
          <value name="node_subtype">unknown</value>
          <value name="node_comment">The starting lump-sum capital balance placed into the account at day zero before any interest is accrued or periodic contributions begin.</value>
          <value name="is_public">false</value>
          <value name="field_name">initialDeposit</value>
          <value name="field_type">string</value>
          <value name="field_dim">0</value>
          <value name="nillable">false</value>
          <value name="form_qualified">false</value>
          <value name="is_global">false</value>
        </record>
        <record javaclass="com.wm.util.Values">
          <value name="node_type">record</value>
          <value name="node_subtype">unknown</value>
          <value name="node_comment">The nominal annual percentage yield (APY) offered on the deposit product, which the calculations break down based on compounding frequency parameters.</value>
          <value name="is_public">false</value>
          <value name="field_name">annualRate</value>
          <value name="field_type">string</value>
          <value name="field_dim">0</value>
          <value name="nillable">false</value>
          <value name="form_qualified">false</value>
          <value name="is_global">false</value>
        </record>
        <record javaclass="com.wm.util.Values">
          <value name="node_type">record</value>
          <value name="node_subtype">unknown</value>
          <value name="node_comment">The numerical frequency code mapping how often interest is calculated and added back to the base principal balance per year (e.g., 1 for Annual, 4 for Quarterly, 12 for Monthly, 365 for Daily).</value>
          <value name="is_public">false</value>
          <value name="field_name">compoundingFrequency</value>
          <value name="field_type">string</value>
          <value name="field_dim">0</value>
          <value name="nillable">false</value>
          <value name="form_qualified">false</value>
          <value name="is_global">false</value>
        </record>
        <record javaclass="com.wm.util.Values">
          <value name="node_type">record</value>
          <value name="node_subtype">unknown</value>
          <value name="node_comment">An optional recurring monthly cash injection added to the principal balance at the beginning or end of each calendar cycle to accelerate compounding growth.</value>
          <value name="is_public">false</value>
          <value name="field_name">monthlyContribution</value>
          <value name="field_type">string</value>
          <value name="field_dim">0</value>
          <value name="field_opt">true</value>
          <value name="nillable">true</value>
          <value name="form_qualified">false</value>
          <value name="is_global">false</value>
        </record>
        <record javaclass="com.wm.util.Values">
          <value name="node_type">record</value>
          <value name="node_subtype">unknown</value>
          <value name="node_comment">The overall duration of the investment timeline expressed in years, establishing the timeline bounds for the generation of the growth matrix.</value>
          <value name="is_public">false</value>
          <value name="field_name">horizonYears</value>
          <value name="field_type">string</value>
          <value name="field_dim">0</value>
          <value name="nillable">false</value>
          <value name="form_qualified">false</value>
          <value name="is_global">false</value>
        </record>
      </array>
      <value name="rec_closed">false</value>
      <value name="modifiable">true</value>
    </record>
    <record name="sig_out" javaclass="com.wm.util.Values">
      <value name="node_type">record</value>
      <value name="node_subtype">unknown</value>
      <value name="is_public">false</value>
      <value name="field_type">record</value>
      <value name="field_dim">0</value>
      <value name="nillable">true</value>
      <value name="form_qualified">false</value>
      <value name="is_global">false</value>
      <array name="rec_fields" type="record" depth="1">
        <record javaclass="com.wm.util.Values">
          <value name="node_type">record</value>
          <value name="node_subtype">unknown</value>
          <value name="node_comment">For every year across the asset lifecycle, the engine will dynamically generate an annual line item tracking the following five properties:
              Year Number
              Starting Balance
              Total Annual Contributions
              Total Annual Interest Earned
              Ending Balance</value>
          <value name="is_public">false</value>
          <value name="field_name">GrowthSchedule</value>
          <value name="field_type">record</value>
          <value name="field_dim">1</value>
          <value name="nillable">true</value>
          <value name="form_qualified">false</value>
          <value name="is_global">false</value>
          <value name="is_soap_array_encoding_used">false</value>
          <array name="rec_fields" type="record" depth="1">
          </array>
          <value name="rec_closed">true</value>
          <value name="modifiable">true</value>
        </record>
        <record javaclass="com.wm.util.Values">
          <value name="node_type">record</value>
          <value name="node_subtype">unknown</value>
          <value name="node_comment">The absolute sum of capital outlays provided by the depositor, calculated as the initial deposit plus all cumulative monthly contributions.</value>
          <value name="is_public">false</value>
          <value name="field_name">totalPrincipalInvested</value>
          <value name="field_type">string</value>
          <value name="field_dim">0</value>
          <value name="nillable">true</value>
          <value name="form_qualified">false</value>
          <value name="is_global">false</value>
        </record>
        <record javaclass="com.wm.util.Values">
          <value name="node_type">record</value>
          <value name="node_subtype">unknown</value>
          <value name="node_comment">The cumulative wealth generated entirely by compound interest accruals over the horizon timeline.</value>
          <value name="is_public">false</value>
          <value name="field_name">totalInterestEarned</value>
          <value name="field_type">string</value>
          <value name="field_dim">0</value>
          <value name="nillable">true</value>
          <value name="form_qualified">false</value>
          <value name="is_global">false</value>
        </record>
        <record javaclass="com.wm.util.Values">
          <value name="node_type">record</value>
          <value name="node_subtype">unknown</value>
          <value name="node_comment">The comprehensive terminal asset valuation of the account at the end of the specified horizon years.</value>
          <value name="is_public">false</value>
          <value name="field_name">finalBalance</value>
          <value name="field_type">string</value>
          <value name="field_dim">0</value>
          <value name="nillable">true</value>
          <value name="form_qualified">false</value>
          <value name="is_global">false</value>
        </record>
        <record javaclass="com.wm.util.Values">
          <value name="node_type">record</value>
          <value name="node_subtype">unknown</value>
          <value name="node_comment">A growth metric indicating the ratio of the final balance relative to the total invested capital, reflecting overall wealth velocity.</value>
          <value name="is_public">false</value>
          <value name="field_name">yieldMultiplier</value>
          <value name="field_type">string</value>
          <value name="field_dim">0</value>
          <value name="nillable">true</value>
          <value name="form_qualified">false</value>
          <value name="is_global">false</value>
        </record>
      </array>
      <value name="rec_closed">false</value>
      <value name="modifiable">true</value>
    </record>
  </record>
  <value name="node_comment">Calculates the growth trajectory of a savings or investment deposit account by applying compounding interest rules to a principal balance across a timeline.</value>
  <value name="stateless">yes</value>
  <value name="caching">no</value>
  <value name="prefetch">no</value>
  <value name="cache_ttl">15</value>
