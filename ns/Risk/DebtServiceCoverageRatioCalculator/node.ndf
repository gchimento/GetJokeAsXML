  <value name="svc_sigtype">unknown</value>
  <record name="svc_sig" javaclass="com.wm.util.Values">
    <record name="sig_in" javaclass="com.wm.util.Values">
      <value name="node_type">record</value>
      <value name="node_subtype">unknown</value>
      <value name="is_public">false</value>
      <value name="field_type">record</value>
      <value name="field_dim">0</value>
      <value name="nillable">true</value>
      <value name="form_qualified">false</value>
      <value name="is_global">false</value>
      <array name="rec_fields" type="record" depth="1">
        <record javaclass="com.wm.util.Values">
          <value name="node_type">record</value>
          <value name="node_subtype">unknown</value>
          <value name="node_comment">The comprehensive top-line gross cash income produced by the commercial entity or property asset before any operating expenses are deducted.</value>
          <value name="is_public">false</value>
          <value name="field_name">grossOperatingRevenue</value>
          <value name="field_type">string</value>
          <value name="field_dim">0</value>
          <value name="nillable">false</value>
          <value name="form_qualified">false</value>
          <value name="is_global">false</value>
        </record>
        <record javaclass="com.wm.util.Values">
          <value name="node_type">record</value>
          <value name="node_subtype">unknown</value>
          <value name="node_comment">The total cost of day-to-day operations (maintenance, insurance, taxes, utilities) excluding non-cash items like depreciation and financial debt obligations.</value>
          <value name="is_public">false</value>
          <value name="field_name">operatingExpenses</value>
          <value name="field_type">string</value>
          <value name="field_dim">0</value>
          <value name="nillable">false</value>
          <value name="form_qualified">false</value>
          <value name="is_global">false</value>
        </record>
        <record javaclass="com.wm.util.Values">
          <value name="node_type">record</value>
          <value name="node_subtype">unknown</value>
          <value name="node_comment">The baseline structural principal payback requirement specified across all outstanding and proposed term notes over a trailing 12-month window.</value>
          <value name="is_public">false</value>
          <value name="field_name">annualPrincipalPayments</value>
          <value name="field_type">string</value>
          <value name="field_dim">0</value>
          <value name="nillable">false</value>
          <value name="form_qualified">false</value>
          <value name="is_global">false</value>
        </record>
        <record javaclass="com.wm.util.Values">
          <value name="node_type">record</value>
          <value name="node_subtype">unknown</value>
          <value name="node_comment">The cumulative interest expenses owed to creditors across the same 12-month operating window.</value>
          <value name="is_public">false</value>
          <value name="field_name">annualInterestPayments</value>
          <value name="field_type">string</value>
          <value name="field_dim">0</value>
          <value name="nillable">false</value>
          <value name="form_qualified">false</value>
          <value name="is_global">false</value>
        </record>
      </array>
      <value name="rec_closed">false</value>
      <value name="modifiable">true</value>
    </record>
    <record name="sig_out" javaclass="com.wm.util.Values">
      <value name="node_type">record</value>
      <value name="node_subtype">unknown</value>
      <value name="is_public">false</value>
      <value name="field_type">record</value>
      <value name="field_dim">0</value>
      <value name="nillable">true</value>
      <value name="form_qualified">false</value>
      <value name="is_global">false</value>
      <array name="rec_fields" type="record" depth="1">
        <record javaclass="com.wm.util.Values">
          <value name="node_type">record</value>
          <value name="node_subtype">unknown</value>
          <value name="node_comment">The raw residual earnings of the asset, calculated as gross operating revenue minus total operating expenses, representing money available for debt service.</value>
          <value name="is_public">false</value>
          <value name="field_name">netOperatingIncome</value>
          <value name="field_type">string</value>
          <value name="field_dim">0</value>
          <value name="nillable">false</value>
          <value name="form_qualified">false</value>
          <value name="is_global">false</value>
        </record>
        <record javaclass="com.wm.util.Values">
          <value name="node_type">record</value>
          <value name="node_subtype">unknown</value>
          <value name="node_comment">The absolute aggregate baseline cash requirement needed to service credit obligations (annual principal plus annual interest).</value>
          <value name="is_public">false</value>
          <value name="field_name">totalAnnualDebtService</value>
          <value name="field_type">string</value>
          <value name="field_dim">0</value>
          <value name="nillable">false</value>
          <value name="form_qualified">false</value>
          <value name="is_global">false</value>
        </record>
        <record javaclass="com.wm.util.Values">
          <value name="node_type">record</value>
          <value name="node_subtype">unknown</value>
          <value name="node_comment">The finalized Debt Service Coverage Ratio multiplier. A value above 1.0 indicates positive cash coverage; values below 1.0 warn of operational cash deficiencies.</value>
          <value name="is_public">false</value>
          <value name="field_name">dscrMetric</value>
          <value name="field_type">string</value>
          <value name="field_dim">0</value>
          <value name="nillable">false</value>
          <value name="form_qualified">false</value>
          <value name="is_global">false</value>
        </record>
        <record javaclass="com.wm.util.Values">
          <value name="node_type">record</value>
          <value name="node_subtype">unknown</value>
          <value name="node_comment">A rule-driven status keyword flag mapping the result directly to institutional risk brackets (e.g., 'PASS', 'MARGINAL_RISK', 'CRITICAL_SHORTFALL').</value>
          <value name="is_public">false</value>
          <value name="field_name">underwritingStatus</value>
          <value name="field_type">string</value>
          <value name="field_dim">0</value>
          <value name="nillable">false</value>
          <value name="form_qualified">false</value>
          <value name="is_global">false</value>
        </record>
        <record javaclass="com.wm.util.Values">
          <value name="node_type">record</value>
          <value name="node_subtype">unknown</value>
          <value name="node_comment">The raw cash cushion remaining in the pipeline after full debt requirements are satisfied, providing an absolute dollar metric of cash safety.</value>
          <value name="is_public">false</value>
          <value name="field_name">safetyMarginCapital</value>
          <value name="field_type">string</value>
          <value name="field_dim">0</value>
          <value name="nillable">false</value>
          <value name="form_qualified">false</value>
          <value name="is_global">false</value>
        </record>
      </array>
      <value name="rec_closed">false</value>
      <value name="modifiable">true</value>
    </record>
  </record>
  <value name="node_comment">Evaluates cash-flow sustainability for commercial credit underwriting by analyzing a company's Net Operating Income against its structural annual debt obligations.</value>
  <value name="stateless">yes</value>
  <value name="caching">no</value>
  <value name="prefetch">no</value>
