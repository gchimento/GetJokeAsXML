        <record javaclass="com.wm.util.Values">
          <value name="node_type">record</value>
          <value name="node_subtype">unknown</value>
          <value name="node_comment">The total number of operational billing cycles required to fully eliminate the card balance under the customized target budget profile.</value>
          <value name="is_public">false</value>
          <value name="field_name">monthsToZeroBalance</value>
