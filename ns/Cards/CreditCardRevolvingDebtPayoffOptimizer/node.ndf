          <value name="node_type">record</value>
          <value name="node_subtype">unknown</value>
          <value name="node_comment">A comparison metric calculating the total finance charges saved by using the target fixed budget over making basic dynamic minimum payments.</value>
          <value name="is_public">false</value>
