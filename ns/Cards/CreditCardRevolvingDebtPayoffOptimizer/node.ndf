        <record javaclass="com.wm.util.Values">
          <value name="node_type">record</value>
          <value name="node_subtype">unknown</value>
          <value name="node_comment">The annual percentage rate associated with the revolving account, reflecting how daily compound finance charges are handled.</value>
          <value name="is_public">false</value>
          <value name="field_name">cardApr</value>
          <value name="field_type">string</value>
          <value name="field_dim">0</value>
          <value name="nillable">false</value>
          <value name="form_qualified">false</value>
