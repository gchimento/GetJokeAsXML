          <value name="node_subtype">unknown</value>
          <value name="node_comment">A month-by-month structural ledger documenting the optimized velocity of the account payload, tracking the following five properties:
              Billing Cycle Month
              Beginning Statement Balance
              Applied Target Payment
              Accrued Finance Charge
              Ending Statement Balance</value>
          <value name="is_public">false</value>
          <value name="field_name">PayoffTimeline</value>
